{
  "name": "shi-market-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "import:master": "node --env-file-if-exists=.env scripts/import-master.js",
    "import:clusters": "node --env-file-if-exists=.env scripts/import-clusters.js",
    "news:sync": "node --env-file-if-exists=.env scripts/sync-newsroom.js",
    "test": "node test/app.test.js && node test/auth.test.js && node test/forecastRunner.test.js"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "openid-client": "^6.8.8",
    "pg": "^8.16.0"
  }
